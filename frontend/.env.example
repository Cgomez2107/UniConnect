# =============================================================================
# UniConnect Mobile - Variables de Entorno
# =============================================================================
# Copia este archivo como .env.local para desarrollo local.
# Para builds en EAS, configura estos valores como EAS Secrets:
#   eas secret:create --scope project --name API_BASE_URL --value <url>
#   eas secret:create --scope project --name SUPABASE_URL --value <url>
#   eas secret:create --scope project --name SUPABASE_ANON_KEY --value <key>
#   eas secret:create --scope project --name OAUTH_CLIENT_ID --value <client-id>
# =============================================================================

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API Backend (Gateway)
EXPO_PUBLIC_API_BASE_URL=https://your-api.fly.dev/api/v1

# OAuth Client ID (Google)
EXPO_PUBLIC_OAUTH_CLIENT_ID=your-oauth-client-id
