          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama3-8b-8192', messages: [{ role: 'system', content: $json.systemPrompt }, { role: 'user', content: $json.pregunta }], temperature: 0.3, max_tokens: 1024 }) }}",
        "options": {
