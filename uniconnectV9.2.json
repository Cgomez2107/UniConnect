      "id": "f7d7462e-9199-4fbc-b095-ad977311ddf9",
      "name": "Has Context?"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all();\nconst { pregunta, rol, userId } = $('Edit Fields').first().json;\n\n// Log para diagnóstico\nconsole.log('Total resultados recibidos:', results.length);\n\nconst getContent = (item) => {\n  const j = item.json;\n  if (!j) return null;\n  return j.pageContent || j.content || j.text || j.document?.pageContent || j.metadata?.pageContent || null;\n};\n\n// 1. Extraemos el score. n8n a veces lo llama 'score', 'similarity', o lo esconde dentro de '_score'.\nconst getScore = (item) => {\n    return item.json?.score || item.json?.similarity || item.json?._score || 0;\n};\n\n// 2. El filtro de oro: Debe tener texto Y el score debe ser mayor a 0.75 (umbral US-CB03)\nconst UMBRAL = 0.75; // Umbral definido por US-CB03: similitud coseno mayor a 0.75\nconst valid = results.filter(r => getContent(r) !== null && getScore(r) >= UMBRAL);\n\n// 3. Si ninguno superó el umbral, nos vamos por el False Branch\nif (valid.length === 0) {\n  return [{ \n      json: { \n          hasContext: false, \n          context: '', \n          referencias: [], \n          pregunta, \n          rol, \n          userId, \n          chunksCount: 0 \n      } \n  }];\n}\n\n// 4. Si pasaron la prueba, armamos el contexto (True Branch)\nconst context = valid.map(r => getContent(r)).join('\\n---\\n');\nconst referencias = valid.map((r, i) => ({\n  id: r.json?.metadata?.id || `chunk-${i+1}`,\n  source: r.json?.metadata?.source || 'Manual UniConnect',\n  similarity: getScore(r)\n}));\n\nconsole.log(JSON.stringify({ event: 'rag_search', rol, chunksCount: valid.length }));\nreturn [{ json: { hasContext: true, context, referencias, pregunta, rol, userId, chunksCount: valid.length } }];"
      },
