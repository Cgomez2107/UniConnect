    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst reply = resp.choices?.[0]?.message?.content || 'No se pudo generar respuesta.';\nconst refs = $('Build Prompt with Context').first().json.referencias || [];\nreturn [{ json: { reply, referencias: refs } }];"
