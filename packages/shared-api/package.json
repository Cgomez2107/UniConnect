{
  "name": "@uniconnect/shared-api",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API clients, transport layer, and data mappers for UniConnect",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./transport": {
      "import": "./dist/transport/index.js",
      "types": "./dist/transport/index.d.ts"
    },
    "./mappers": {
      "import": "./dist/mappers/index.js",
      "types": "./dist/mappers/index.d.ts"
    },
    "./clients": {
      "import": "./dist/clients/index.js",
      "types": "./dist/clients/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./services": {
      "import": "./src/services/index.ts",
      "types": "./dist/services/index.d.ts"
    }
  },

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --import tsx/esm --test src/clients/__tests__/BaseClient.test.ts src/services/__tests__/StorageService.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "@uniconnect/shared-types": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "uniconnect",
    "api",
    "client",
    "transport",
    "mapper"
  ]
}
