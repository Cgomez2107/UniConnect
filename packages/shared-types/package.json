{
  "name": "@uniconnect/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and domain interfaces for UniConnect",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./domain": {
      "import": "./dist/domain/index.js",
      "types": "./dist/domain/index.d.ts"
    },
    "./dto": {
      "import": "./dist/dto/index.js",
      "types": "./dist/dto/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors/index.js",
      "types": "./dist/errors/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "keywords": [
    "uniconnect",
    "types",
    "shared",
    "domain"
  ]
}
