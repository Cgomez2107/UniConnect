{
  "name": "@uniconnect/shared-hooks",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React hooks for UniConnect",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@uniconnect/shared-api": "workspace:*",
    "@uniconnect/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "typescript": "^5.7.2"
  },
  "keywords": ["hooks", "react"],
  "license": "MIT"
}
