{
  "title": "UniConnect Messaging Service",
  "version": "0.1.0",
  "serverUrl": "http://localhost:3104",
  "basePath": "/api/v1",
  "paths": {
    "/api/v1/conversations": {
      "get": {
        "summary": "Listar conversaciones",
        "description": "Obtiene todas las conversaciones del usuario autenticado, incluyendo el último mensaje y conteo de no leídos.",
        "tags": [
          "Messaging"
        ],
        "responses": {
          "200": {
            "description": "Lista de conversaciones obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_conversations_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      },
      "post": {
        "summary": "Obtener o crear conversación",
        "description": "Obtiene una conversación existente con el participante indicado o crea una nueva.",
        "tags": [
          "Messaging"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_conversations_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversación existente encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_conversations_200Response"
                }
              }
            }
          },
          "201": {
            "description": "Conversación creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_conversations_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/conversations/{id}": {
      "get": {
        "summary": "Obtener conversación por ID",
        "description": "Retorna una conversación específica si el usuario autenticado es participante.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversación encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_conversations_id_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          },
          "404": {
            "description": "Conversación no encontrada"
          }
        }
      }
    },
    "/api/v1/conversations/{id}/touch": {
      "patch": {
        "summary": "Actualizar timestamp de conversación",
        "description": "Actualiza el timestamp updated_at de una conversación (ej. al escribir o previsualizar).",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversación actualizada"
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/conversations/{id}/read": {
      "patch": {
        "summary": "Marcar conversación como leída",
        "description": "Marca todos los mensajes no leídos de una conversación como leídos para el usuario autenticado.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversación marcada como leída",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patch_conversations_id_read_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/messages/unread-count": {
      "get": {
        "summary": "Obtener conteo de no leídos",
        "description": "Retorna el número total de mensajes no leídos en todas las conversaciones del usuario.",
        "tags": [
          "Messaging"
        ],
        "responses": {
          "200": {
            "description": "Conteo obtenido exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_messages_unread_count_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/messages": {
      "get": {
        "summary": "Listar mensajes de una conversación",
        "description": "Obtiene los mensajes de una conversación con paginación.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "name": "conversationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0,
                  "maximum": 100,
                  "default": 50
                }
              ]
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de mensajes obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_messages_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      },
      "post": {
        "summary": "Enviar un mensaje",
        "description": "Envía un mensaje de texto (opcionalmente con adjuntos multimedia o respuesta a otro mensaje) en una conversación.",
        "tags": [
          "Messaging"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_messages_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mensaje creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_messages_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/messages/{id}": {
      "get": {
        "summary": "Obtener mensaje por ID",
        "description": "Retorna un mensaje específico por su ID.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mensaje encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_messages_id_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          },
          "404": {
            "description": "Mensaje no encontrado"
          }
        }
      }
    },
    "/api/v1/messages/{id}/reactions": {
      "post": {
        "summary": "Agregar o quitar reacción",
        "description": "Alterna una reacción con emoji en un mensaje. Si el usuario ya reaccionó con ese emoji, se elimina; si no, se agrega.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_messages_id_reactions_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reacción actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_messages_id_reactions_200Response"
                }
              }
            }
          },
          "400": {
            "description": "El campo emoji es requerido"
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/messages/{id}/read": {
      "patch": {
        "summary": "Marcar mensaje como leído",
        "description": "Marca un mensaje individual como leído estableciendo el timestamp read_at.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mensaje marcado como leído"
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          },
          "404": {
            "description": "Mensaje no encontrado"
          }
        }
      }
    },
    "/api/v1/polls": {
      "post": {
        "summary": "Crear una encuesta en un mensaje de grupo",
        "description": "Crea una encuesta asociada a un mensaje existente en un grupo de estudio. El usuario autenticado debe ser miembro del grupo.",
        "tags": [
          "Polls"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_polls_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Encuesta creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_polls_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación — datos de entrada inválidos"
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/polls/{pollId}/votes": {
      "post": {
        "summary": "Emitir un voto en una encuesta activa",
        "description": "Registra el voto de un usuario en una opción de una encuesta activa. Cada usuario solo puede votar una vez.",
        "tags": [
          "Polls"
        ],
        "parameters": [
          {
            "name": "pollId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_polls_pollId_votes_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Voto registrado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_polls_pollId_votes_200Response"
                }
              }
            }
          },
          "400": {
            "description": "Error del negocio — voto duplicado, encuesta cerrada u opción inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_polls_pollId_votes_400Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/polls/{pollId}/results": {
      "get": {
        "summary": "Obtener resultados actuales de una encuesta",
        "description": "Retorna los resultados agregados de una encuesta, incluyendo el conteo de votos por opción y el total de votos.",
        "tags": [
          "Polls"
        ],
        "parameters": [
          {
            "name": "pollId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de la encuesta obtenidos exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_polls_pollId_results_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          },
          "404": {
            "description": "Encuesta no encontrada"
          }
        }
      }
    }
  },
