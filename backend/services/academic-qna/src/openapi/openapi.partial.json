{
  "title": "UniConnect Academic Q&A Service",
  "version": "0.1.0",
  "serverUrl": "http://localhost:3107",
  "basePath": "/api/v1",
  "paths": {
    "/api/v1/forum/questions": {
      "get": {
        "summary": "Listar preguntas del foro académico",
        "description": "Obtiene una lista paginada de preguntas del foro. Puede filtrarse por materia.",
        "tags": [
          "Academic Q&A"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0,
                  "default": 1
                }
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0,
                  "maximum": 100,
                  "default": 20
                }
              ]
            }
          },
          {
            "name": "subjectId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "uuid"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de preguntas obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_forum_questions_200Response"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear una nueva pregunta",
        "description": "Publica una nueva pregunta en el foro académico. El usuario autenticado aparece como autor.",
        "tags": [
          "Academic Q&A"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_forum_questions_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pregunta creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_forum_questions_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación — datos de entrada inválidos"
          }
        }
      }
    },
    "/api/v1/forum/questions/{questionId}": {
      "get": {
        "summary": "Obtener detalle de una pregunta",
        "description": "Retorna una pregunta específica con todas sus respuestas.",
        "tags": [
          "Academic Q&A"
        ],
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la pregunta obtenido exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_forum_questions_questionId_200Response"
                }
              }
            }
          },
          "404": {
            "description": "Pregunta no encontrada"
          }
        }
      }
    },
    "/api/v1/forum/questions/{questionId}/answers": {
      "get": {
        "summary": "Listar respuestas de una pregunta",
        "description": "Obtiene todas las respuestas asociadas a una pregunta específica.",
        "tags": [
          "Academic Q&A"
        ],
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de respuestas obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_forum_questions_questionId_answers_200Response"
                }
              }
            }
          },
          "404": {
            "description": "Pregunta no encontrada"
          }
        }
      },
      "post": {
        "summary": "Crear una respuesta",
        "description": "Publica una respuesta a una pregunta existente en el foro.",
        "tags": [
          "Academic Q&A"
        ],
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_forum_questions_questionId_answers_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Respuesta creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_forum_questions_questionId_answers_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación — datos de entrada inválidos"
          },
          "404": {
            "description": "Pregunta no encontrada"
          }
        }
      }
    },
    "/api/v1/forum/questions/{questionId}/solution": {
      "post": {
        "summary": "Marcar respuesta como solución",
        "description": "Marca una respuesta como la solución aceptada de una pregunta. Solo el autor de la pregunta puede marcar la solución.",
        "tags": [
          "Academic Q&A"
        ],
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_forum_questions_questionId_solution_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solución marcada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_forum_questions_questionId_solution_200Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          },
          "404": {
            "description": "Pregunta o respuesta no encontrada"
          }
        }
      }
    },
    "/api/v1/forum/votes": {
      "post": {
        "summary": "Votar por una pregunta o respuesta",
        "description": "Emite un voto positivo o negativo sobre una pregunta o respuesta.",
        "tags": [
          "Academic Q&A"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_forum_votes_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Voto registrado exitosamente"
          },
          "400": {
            "description": "Error de validación — tipo de voto o destino inválido"
          }
        }
      }
    }
  },
