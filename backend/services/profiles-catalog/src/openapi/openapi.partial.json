{
  "title": "UniConnect Profiles Catalog Service",
  "version": "0.1.0",
  "serverUrl": "http://localhost:3105",
  "basePath": "/api/v1",
  "paths": {
    "/api/v1/students/me": {
      "get": {
        "summary": "Obtener perfil propio",
        "description": "Retorna el perfil completo del usuario autenticado. Si no existe, lo crea con valores por defecto.",
        "tags": [
          "Profiles Catalog"
        ],
        "responses": {
          "200": {
            "description": "Perfil obtenido exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_students_me_200Response"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Actualizar perfil propio",
        "description": "Actualiza los campos del perfil del usuario autenticado.",
        "tags": [
          "Profiles Catalog"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Patch_students_me_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil actualizado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patch_students_me_200Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          }
        }
      }
    },
    "/api/v1/students/profile": {
      "post": {
        "summary": "Crear perfil de estudiante",
        "description": "Crea un perfil de estudiante con el nombre completo proporcionado.",
        "tags": [
          "Profiles Catalog"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_students_profile_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Perfil creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_students_profile_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          }
        }
      }
    },
    "/api/v1/students/me/primary-program": {
      "patch": {
        "summary": "Establecer programa principal",
        "description": "Define el programa académico principal del usuario autenticado.",
        "tags": [
          "Profiles Catalog"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Patch_students_me_primary_program_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Programa principal actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patch_students_me_primary_program_200Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          }
        }
      }
    },
    "/api/v1/students/me/programs": {
      "get": {
        "summary": "Obtener programas del usuario",
        "description": "Lista los programas académicos en los que el usuario está inscrito.",
        "tags": [
          "Profiles Catalog"
        ],
        "responses": {
          "200": {
            "description": "Lista de programas obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_students_me_programs_200Response"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/me/subjects": {
      "get": {
        "summary": "Obtener materias del usuario",
        "description": "Lista las materias que el usuario tiene registradas.",
        "tags": [
          "Profiles Catalog"
        ],
        "responses": {
          "200": {
            "description": "Lista de materias obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_students_me_subjects_200Response"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Agregar materia al usuario",
        "description": "Registra una materia en el perfil del usuario autenticado.",
        "tags": [
          "Profiles Catalog"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_students_me_subjects_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Materia agregada exitosamente"
          },
          "400": {
            "description": "Error de validación"
          }
        }
      }
    },
    "/api/v1/students/me/subjects/{subjectId}": {
      "delete": {
        "summary": "Eliminar materia del usuario",
        "description": "Elimina una materia del perfil del usuario autenticado.",
        "tags": [
          "Profiles Catalog"
        ],
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Materia eliminada exitosamente"
          },
          "404": {
            "description": "Materia no encontrada"
          }
        }
      }
    },
    "/api/v1/students/me/avatar": {
      "post": {
        "summary": "Subir avatar",
        "description": "Sube o actualiza la imagen de avatar del usuario autenticado.",
        "tags": [
          "Profiles Catalog"
        ],
        "requestBody": {
          "required": true,
