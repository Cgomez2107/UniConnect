          }
        }
      }
    },
    "/api/v1/students": {
      "get": {
        "summary": "Buscar estudiantes",
        "description": "Busca estudiantes por materia, texto libre, o lista todos.",
        "tags": [
          "Profiles Catalog"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "maxLength": 200
                }
              ]
            }
          },
          {
            "name": "subjectId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          {
            "name": "currentUserId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "uuid"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de estudiantes obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_students_200Response"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/{id}": {
      "get": {
        "summary": "Obtener perfil público de estudiante",
        "description": "Retorna la información pública del perfil de un estudiante por su ID.",
        "tags": [
          "Profiles Catalog"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "vista",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "enum": [
                    "completa"
                  ]
                }
              ]
            }
          },
          {
            "name": "currentUserId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "uuid"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil encontrado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_students_id_200Response"
                }
              }
            }
          },
          "404": {
            "description": "Perfil no encontrado"
          }
        }
      }
    },
