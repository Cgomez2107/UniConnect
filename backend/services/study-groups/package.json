{
  "name": "@uniconnect/study-groups",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/services/study-groups/src/main.js",
    "generate:openapi": "tsx src/openapi/index.ts",
    "lint": "echo \"study-groups lint config scaffold\"",
    "typecheck": "tsc --noEmit",
    "test": "jest test/sendgrid-gateway.spec.ts test/supabase-push-gateway.spec.ts",
    "test:integration": "vitest run tests/integration/study-group.integration.spec.ts --coverage"
  },
  "dependencies": {
    "@uniconnect/shared-types": "file:../../../packages/shared-types",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.105.4",
    "@uniconnect/shared-types": "file:../../../packages/shared-types",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "jest": "^30.0.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
