{
  "title": "UniConnect Events Service",
  "version": "0.1.0",
  "serverUrl": "http://localhost:3106",
  "basePath": "/api/v1",
  "paths": {
    "/api/v1/events": {
      "get": {
        "summary": "Listar eventos académicos",
        "description": "Obtiene una lista de eventos. Puede filtrarse por próximos (upcoming).",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "upcoming",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de eventos obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_events_200Response"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear un evento",
        "description": "Crea un nuevo evento académico.",
        "tags": [
          "Events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_events_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Evento creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_events_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          }
        }
      }
    },
    "/api/v1/events/{id}": {
      "get": {
        "summary": "Obtener evento por ID",
        "description": "Retorna la información detallada de un evento específico.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evento encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_events_id_200Response"
                }
              }
            }
          },
          "404": {
            "description": "Evento no encontrado"
          }
        }
      },
      "put": {
        "summary": "Actualizar un evento",
        "description": "Actualiza los datos de un evento existente.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Put_events_id_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evento actualizado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Put_events_id_200Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          },
          "404": {
            "description": "Evento no encontrado"
          }
        }
      },
      "delete": {
        "summary": "Eliminar un evento",
        "description": "Elimina un evento académico.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evento eliminado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delete_events_id_200Response"
                }
              }
            }
          },
          "404": {
            "description": "Evento no encontrado"
          }
        }
      }
    },
    "/api/v1/eventos/suscribir": {
      "post": {
        "summary": "Suscribirse a una categoría de eventos",
        "description": "Suscribe al usuario autenticado a una categoría de eventos para recibir notificaciones.",
        "tags": [
          "Events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_eventos_suscribir_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Suscripción exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_eventos_suscribir_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación — categoría inválida"
          }
        }
      },
      "delete": {
        "summary": "Desuscribirse de una categoría",
        "description": "Elimina la suscripción del usuario autenticado a una categoría de eventos.",
        "tags": [
          "Events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Delete_eventos_suscribir_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Desuscripción exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delete_eventos_suscribir_200Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación"
          }
        }
      }
    },
    "/api/v1/eventos/suscripciones": {
      "get": {
        "summary": "Obtener suscripciones del usuario",
        "description": "Retorna las categorías de eventos a las que el usuario autenticado está suscrito.",
        "tags": [
          "Events"
        ],
        "responses": {
          "200": {
            "description": "Suscripciones obtenidas exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_eventos_suscripciones_200Response"
                }
              }
            }
          }
        }
      }
    }
  },
