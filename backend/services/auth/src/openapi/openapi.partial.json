{
  "title": "UniConnect Auth Service",
  "version": "0.1.0",
  "serverUrl": "http://localhost:3102",
  "basePath": "/api/v1",
  "paths": {
    "/api/v1/auth/signin": {
      "post": {
        "summary": "Iniciar sesión con credenciales",
        "description": "Autentica al usuario con email y contraseña. Retorna un token JWT de acceso, refresh token y los datos del perfil.",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_auth_signin_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inicio de sesión exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_auth_signin_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas — email o contraseña incorrectos"
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "summary": "Registrar un nuevo usuario",
        "description": "Crea una cuenta de usuario con email corporativo @ucaldas.edu.co, contraseña y nombre completo.",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_auth_signup_RequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_auth_signup_201Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación — datos de entrada inválidos"
          },
          "409": {
            "description": "El email ya está registrado"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Renovar token de acceso",
        "description": "Intercambia un refresh token válido por un nuevo par de tokens.",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_auth_refresh_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens renovados exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_auth_refresh_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token inválido o expirado"
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "summary": "Obtener sesión actual",
        "description": "Retorna la información de la sesión actual del usuario autenticado.",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Sesión obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_auth_session_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Obtener perfil del usuario autenticado",
        "description": "Retorna los datos básicos del perfil del usuario autenticado.",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Perfil obtenido exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_auth_me_200Response"
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación requerido o inválido"
          }
        }
      }
    },
    "/api/v1/auth/google": {
      "get": {
        "summary": "Obtener URL de autenticación Google OAuth (GET)",
        "description": "Genera la URL de redirección para iniciar el flujo de autenticación con Google. Acepta redirectTo como query param.",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "redirectTo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "URL de OAuth generada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Get_auth_google_200Response"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Obtener URL de autenticación Google OAuth (POST)",
        "description": "Genera la URL de redirección para iniciar el flujo de autenticación con Google. Acepta redirectTo en el body.",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_auth_google_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "URL de OAuth generada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_auth_google_200Response"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oauth/callback": {
      "post": {
        "summary": "Procesar callback de OAuth",
        "description": "Intercambia un token de acceso de Supabase (obtenido del flujo OAuth) por un par de tokens JWT del backend.",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post_auth_oauth_callback_RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación OAuth completada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post_auth_oauth_callback_200Response"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación — accessToken o email faltantes"
          }
        }
      }
    }
  },
  "components": {
