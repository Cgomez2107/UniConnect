                    "maxLength": 100
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "estudiante",
                      "admin"
                    ]
                  },
                  "profileImageUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "isVerified": {
                    "type": "boolean"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "isOnboarded": {
                    "type": "boolean"
                  },
                  "lastLoginAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "id",
                  "email",
                  "firstName",
                  "lastName",
                  "role",
                  "isVerified",
                  "createdAt",
                  "updatedAt",
                  "isOnboarded"
                ],
                "additionalProperties": false
              },
              "accessToken": {
                "type": "string",
                "minLength": 1
              },
              "refreshToken": {
                "type": "string",
                "minLength": 1
              },
              "expiresIn": {
                "type": "number",
                "exclusiveMinimum": true,
                "minimum": 0
              }
            },
            "required": [
              "user",
              "accessToken",
              "refreshToken",
              "expiresIn"
            ],
            "additionalProperties": false
