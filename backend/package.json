{
  "name": "uniconnect-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UniConnect backend microservices monorepo",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:tunnel": "concurrently \"pnpm dev\" \"ngrok http 3000\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "echo \"format config pending\"",
    "gateway:dev": "pnpm --filter @uniconnect/gateway dev",
    "study-groups:dev": "pnpm --filter @uniconnect/study-groups dev",
    "resources:dev": "pnpm --filter @uniconnect/resources dev",
    "messaging:dev": "pnpm --filter @uniconnect/messaging dev",
    "openapi:pipeline": "turbo run generate:openapi merge:openapi generate:api-types",
    "test:coverage": "npx c8 --reporter=lcov --reporter=html --reporter=json-summary --include=\"shared/patterns/decorator/**/*.ts\" --include=\"shared/patterns/observer/**/*.ts\" --check-coverage --lines=70 --branches=70 --functions=70 --statements=70 node --import tsx --test tests/unit/decorators/*.spec.ts tests/feat/us-d01-decorator-pattern.spec.ts tests/feat/us-d03-notification-decorators.spec.ts tests/feat/us-o03-event-observer.spec.ts && bash scripts/check-patterns-coverage.sh"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "turbo": "^2.1.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2"
  }
}
